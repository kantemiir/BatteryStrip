<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <AssemblyName>BatteryStrip</AssemblyName>
    <RootNamespace>BatteryStrip</RootNamespace>
    <AssemblyTitle>Заряд устройств</AssemblyTitle>
    <Description>Заряд беспроводных устройств на панели задач</Description>
    <Prefer32Bit>false</Prefer32Bit>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <!-- The program is a single exe: no .config file next to it, debug info embedded for readable log traces. -->
    <AutoGenerateBindingRedirects>false</AutoGenerateBindingRedirects>
    <GenerateSupportedRuntime>false</GenerateSupportedRuntime>
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="System.Drawing" />
    <Reference Include="UIAutomationClient" />
    <Reference Include="UIAutomationTypes" />
    <Reference Include="WindowsBase" />
  </ItemGroup>

  <!-- Windows Runtime metadata for toast notifications; present on every Windows 10 and 11. -->
  <ItemGroup>
    <Reference Include="Windows.Foundation">
      <HintPath>$(SystemRoot)\System32\WinMetadata\Windows.Foundation.winmd</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Windows.Data">
      <HintPath>$(SystemRoot)\System32\WinMetadata\Windows.Data.winmd</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Windows.UI">
      <HintPath>$(SystemRoot)\System32\WinMetadata\Windows.UI.winmd</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Windows.Gaming">
      <HintPath>$(SystemRoot)\System32\WinMetadata\Windows.Gaming.winmd</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Windows.Devices">
      <HintPath>$(SystemRoot)\System32\WinMetadata\Windows.Devices.winmd</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Windows.System">
      <HintPath>$(SystemRoot)\System32\WinMetadata\Windows.System.winmd</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="BatteryStrip.Tests" />
    <!-- Set by the release build (-p:GitHubRepository=owner/name); enables the update check. -->
    <AssemblyMetadata Include="Repository" Value="$(GitHubRepository)" />
  </ItemGroup>

</Project>
